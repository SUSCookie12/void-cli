{
  "name": "void-server",
  "version": "0.1.6",
  "description": "Void Server Daemon — Minecraft Server Management",
  "type": "module",
  "main": "dist/bundle.cjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --external:fsevents --alias:react-devtools-core=./src/stubs/react-devtools-core.ts --alias:yoga-wasm-web/auto=./src/shims/yoga-wasm-auto.ts --outfile=dist/bundle.cjs",
    "package:win": "pkg . --targets node18-win-x64 --output dist/voidmc.exe --compress GZip --public",
    "package:linux": "pkg . --targets node18-linux-x64 --output dist/voidmc-linux --compress GZip --public",
    "package:all": "npm run build && npx pkg launcher.cjs --targets node18-win-x64 --output dist/voidmc.exe --public && npx pkg launcher.cjs --targets node18-linux-x64 --output dist/voidmc-linux --public"
  },
  "bin": {
    "voidmc": "launcher.cjs"
  },
  "dependencies": {
    "@types/node": "^25.6.0",
    "@types/qrcode-terminal": "^0.12.2",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "chalk": "^5.3.0",
    "extract-zip": "^2.0.1",
    "firebase": "^10.12.0",
    "ink": "^4.4.1",
    "ink-select-input": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "nat-api": "^0.3.1",
    "pidusage": "^4.0.1",
    "prismarine-nbt": "^2.8.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.0",
    "sharp": "^0.34.5",
    "tar": "^7.5.13",
    "uuid": "^9.0.1",
    "werift": "^0.22.9"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^18.3.0",
    "@types/tar": "^6.1.13",
    "@types/uuid": "^9.0.8",
    "esbuild": "^0.21.5",
    "pkg": "^5.8.1",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "pkg": {
    "assets": [
      "dist/bundle.cjs"
    ]
  }
}
